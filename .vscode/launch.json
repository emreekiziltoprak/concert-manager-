{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker Backend Debug",
      "type": "node",
      "request": "attach", // "launch" (başlat) yerine "attach" (çalışana bağlan) diyoruz
      "port": 9229,
      "address": "localhost",
      "restart": true,
      "localRoot": "${workspaceFolder}/backend", // Senin ekranındaki kodlar
      "remoteRoot": "/app", // Docker'ın içindeki kodlar (Eşleştirme için kritik!)
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}