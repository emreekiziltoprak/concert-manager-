# Copy to .env.test to run the suite locally: cp .env.test.example .env.test
# tests/helpers/loadEnv.js loads .env.test and overrides the ambient env, so
# this must point at a throwaway database -- every test truncates all tables.
#
# CI does not use this file; .github/workflows/tests.yml sets the same
# variables directly. Keep the two in sync.

# Port 5433 is what docker-compose maps concert_postgres to on the host, and
# `admin` is the POSTGRES_USER it provisions the container with.
#
# The database does not exist on a fresh checkout -- create it once, then let
# prisma build the schema:
#   docker exec concert_postgres psql -U admin -d postgres -c "CREATE DATABASE concert_test;"
#   DATABASE_URL=postgresql://admin:postgres@localhost:5433/concert_test npx prisma migrate deploy
DATABASE_URL=postgresql://admin:postgres@localhost:5433/concert_test

JWT_SECRET=local-test-secret

# Stripe is mocked in the suite (tests/helpers/stripeMock.js); these only need
# to be non-empty so stripeClient.js can be constructed at import time.
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy

# Never used -- no test sends mail -- but emailService.js reads them on import.
EMAIL_USER=test@example.com
EMAIL_PASS=dummy-password
